{
  "manifest_version": 3,
  "name": "Sootling",
  "version": "0.1.0",
  "description": "Estimate browser AI chat token usage and forward it to the Sootling macOS app.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
